    cmd=(cmd or ''):lower()
    if cmd=='' then
       queryStatus=string.format('AUTO JOIN: %s | minRate=%s | minRarity=%s',
         autoJoin.enabled and 'ON' or 'OFF', money(autoJoin.minRate), autoJoin.minRank)
    elseif cmd=='on' then
       autoJoin.enabled=true;
      saveSettings();
      queryStatus='AUTO JOIN: ON'
    elseif cmd=='off' then
       autoJoin.enabled=false;
      saveSettings();
      queryStatus='AUTO JOIN: OFF'
    elseif cmd=='rate' then
       local v=parseAmount(arg1)
      if v then
         autoJoin.minRate=v; saveSettings();
        queryStatus='AUTO JOIN rate: '..money(v)
      else
         queryStatus='Usage: /s rate 1b'
      end
    elseif cmd=='rarity' then
       local r=rarityNameToRank(arg1)
      if r then
         autoJoin.minRank=r; saveSettings();
        queryStatus='AUTO JOIN rarity: '..arg1:lower()
      else
         queryStatus='Usage: /s rarity divine'
      end
    elseif cmd=='cooldown' then
       local v=tonumber(arg1)
      if v and v>=2 and v<=120 then
         autoJoin.cooldown=v; saveSettings();
        queryStatus='AUTO JOIN cooldown: '..v..'s'
      else
         queryStatus='Usage: /s cooldown 8'
      end
    elseif cmd=='reset' then
       autoJoin.enabled=false;
      autoJoin.minRate=0;
      autoJoin.minRank=0;
      autoJoin.cooldown=8;
      saveSettings();
      queryStatus='AUTO JOIN reset'
