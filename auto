      local alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
      local values={}
      for i=1,#alphabet do values[alphabet:sub(i,i)]=i-1 end
      local function decode(value)
        local out,buffer,bits={},0,0
        for i=1,#value do
          local digit=values[value:sub(i,i)]
          if digit then
            buffer=buffer*64+digit;
            bits+=6
            if bits>=8 then
              bits-=8;
              out[#out+1]=string.char(math.floor(buffer/2^bits)%256);
              buffer=buffer%2^bits
            end
          end
        end
        return table.concat(out)
      end
      D.decodeAsset=decode
      for key,spec in pairs(mutationSpriteData) do
        local ok,uri=pcall(function()
          local filename='jen_minecraft_'..key..'_v1.png'
          writefile(filename,decode(spec.data))
          return asset(filename)
        end)
